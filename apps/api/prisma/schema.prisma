// Modelo del catálogo. Decisiones y alternativas: docs/decisions/0006-modelo-de-datos-del-catalogo.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  perfumes    Perfume[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Perfume {
  id          String   @id @default(uuid())
  slug        String
  name        String
  description String?
  // Volumen del frasco en mililitros. null = por definir.
  sizeMl      Int?
  // Precio en céntimos de sol (PEN). null = precio por definir.
  priceCents  Int?
  imageUrl    String?
  notesTop    String[] @default([])
  notesHeart  String[] @default([])
  notesBase   String[] @default([])
  // Texto libre por ahora; la lista de ocasiones está por definir.
  occasions   String[] @default([])
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, slug])
  @@index([brandId])
}
