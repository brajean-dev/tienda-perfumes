{
  "name": "tienda-perfumes",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "pnpm --filter @tienda/api test:db",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tienda/api db:generate",
    "db:migrate": "pnpm --filter @tienda/api db:migrate",
    "db:seed": "pnpm --filter @tienda/api db:seed",
    "db:test:prepare": "bash scripts/db-test-prepare.sh",
    "contracts:generate": "pnpm --filter @tienda/contracts generate",
    "contracts:check": "pnpm --filter @tienda/contracts check"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
