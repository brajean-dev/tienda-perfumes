# Copia este archivo a .env y reemplaza los valores. .env NO se versiona.

# PostgreSQL local (docker-compose.yml)
POSTGRES_USER=perfumeria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=perfumeria

# Conexión de la API. Usa el mismo usuario, contraseña y base de datos de arriba.
DATABASE_URL=postgresql://perfumeria:change-me@localhost:5432/perfumeria

# API (apps/api)
API_PORT=3000

# Web (apps/web). Todo lo que empiece por VITE_ queda visible en el navegador: nunca pongas secretos aquí.
VITE_API_URL=http://localhost:3000
