# Copia este archivo a .env y reemplaza los valores. .env NO se versiona.

# PostgreSQL local (docker-compose.yml)
POSTGRES_USER=perfumeria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=perfumeria

# Conexión de la API. Usa el mismo usuario, contraseña y base de datos de arriba.
DATABASE_URL=postgresql://perfumeria:change-me@localhost:5432/perfumeria

# Base de pruebas de integración (`pnpm db:test:prepare` la crea; `pnpm test:db` la usa).
# Debe ser OTRA base que la de desarrollo y su nombre debe terminar en "_test": esas pruebas borran datos.
TEST_DATABASE_URL=postgresql://perfumeria:change-me@localhost:5432/perfumeria_test

# API (apps/api)
API_PORT=3000
# Dirección en la que escucha la API. 127.0.0.1 = solo accesible desde esta máquina.
API_HOST=127.0.0.1
# Origen exacto de la web (esquema + host + puerto, sin ruta; solo http o https).
# La API solo acepta CORS desde aquí: si cambias el puerto de la web, cámbialo también aquí,
# o el navegador bloqueará las peticiones y la web mostrará "Sin conexión con la API".
WEB_ORIGIN=http://localhost:5173

# Web (apps/web). Todo lo que empiece por VITE_ queda visible en el navegador: nunca pongas secretos aquí.
# URL base de la API (si la dejas vacía se usa http://localhost:3000; la barra final se ignora).
VITE_API_URL=http://localhost:3000
